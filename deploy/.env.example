# Copy to .env next to docker-compose.yml. Every value is optional.

TZ=America/New_York

# Generate once: openssl rand -base64 48
HOMESTEAD_SECRET_KEY=

# Set true when a reverse proxy terminates TLS in front of Homestead.
TRUST_PROXY=false

# Email reminders (optional). Without these, reminders live in the in-app inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=homestead@yourdomain

# Push notifications through a self-hosted ntfy or Gotify (optional).
NTFY_URL=
NTFY_TOPIC=
GOTIFY_URL=
GOTIFY_TOKEN=

# Opt in to looking unknown barcodes up against Open Food Facts. Default off.
HOMESTEAD_EXTERNAL_LOOKUPS=false
