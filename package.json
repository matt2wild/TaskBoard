{
  "name": "homestead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @homestead/server & npm run dev --workspace @homestead/web",
    "build": "npm run build --workspace @homestead/shared && npm run build --workspace @homestead/server && npm run build --workspace @homestead/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node apps/server/dist/main.js",
    "seed": "npm run seed --workspace @homestead/server"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
